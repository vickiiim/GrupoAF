# =============================================================================
# Variables de entorno del backend (NestJS)
# Copiar este archivo como ".env" y completar los valores:
#   cp .env.example .env
# =============================================================================

# Puerto donde escucha el backend (Nginx hace proxy_pass hacia este puerto)
PORT=3000

# Entorno de ejecucion: development | production
NODE_ENV=development

# --- Base de datos PostgreSQL -------------------------------------------------
# Si usas Docker: docker run -p 5434:5432 postgres:16
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=clinica_medica

# --- Datos de prueba (seeders) ------------------------------------------------
# Crea usuarios, medicos y reservas de ejemplo al iniciar si todavia no existen.
# Desactivar en produccion: SEED_DEFAULT_USERS=false
SEED_DEFAULT_USERS=true
# Contrasena inicial de los usuarios de prueba (minimo 6 caracteres)
SEED_DEFAULT_PASSWORD=123456

# --- Autenticacion JWT --------------------------------------------------------
# Clave para firmar los tokens (cambiar por una clave larga y aleatoria)
JWT_SECRET=clave_secreta_de_desarrollo_cambiar_en_produccion
JWT_EXPIRES_IN=1h
